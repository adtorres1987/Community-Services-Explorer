# Copy to .env and set a local password. .env is not committed.
POSTGRES_DB=community_services
POSTGRES_USER=cse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Port for the full Docker stack (http://localhost:8080)
APP_PORT=8080

# Comma-separated origins allowed to call the API (frontend dev server)
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
